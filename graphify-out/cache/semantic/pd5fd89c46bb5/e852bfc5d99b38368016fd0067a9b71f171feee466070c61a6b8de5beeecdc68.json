{"nodes": [{"id": "_agents_skills_graphify_skill_skill", "label": "Graphify Skill", "file_type": "document", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_knowledge_graph", "label": "Knowledge Graph", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_community_detection", "label": "Community Detection", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_fast_path", "label": "Fast Path Existing Graph", "file_type": "rationale", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json exists and the user asks a natural-language codebase question (not --update, --cluster-only, or a rebuild path), skip Steps 1-5 and run graphify query immediately so the already-built graph is used instead of re-extracted."}, {"id": "_agents_skills_graphify_skill_ast_extraction", "label": "Structural AST Extraction", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code is extracted structurally with no LLM and no API key; a code-only corpus skips semantic extraction entirely."}, {"id": "_agents_skills_graphify_skill_semantic_extraction", "label": "Semantic Extraction", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_semantic_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache entries are attributed to extraction-spec.md so a prompt upgrade invalidates old entries while unchanged prompts replay hits (#1939)."}, {"id": "_agents_skills_graphify_skill_no_api_key", "label": "No API Key Required", "file_type": "rationale", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify never asks for or blocks on an API key. Gemini is used only if GEMINI_API_KEY/GOOGLE_API_KEY is already set; otherwise the host agent is the LLM. ANTHROPIC_API_KEY and OPENAI_API_KEY are not read."}, {"id": "_agents_skills_graphify_skill_gemini_backend", "label": "Gemini Semantic Backend", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_shrink_guard", "label": "Shrink Guard", "file_type": "rationale", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json returns False and writes nothing when the new graph is smaller than existing graph.json (#479), so GRAPH_REPORT.md never describes a graph that graph.json does not contain."}, {"id": "_agents_skills_graphify_skill_graph_health_check", "label": "Graph Health Check", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only integrity gate before labeling; surfaces dangling endpoints, self-loops, and collapsed edges without aborting so silent incremental corruption stays visible."}, {"id": "_agents_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS if unsure); never skip the corpus-size warning; always show token cost and raw cohesion numbers; never run HTML viz on >5000 nodes without warning."}, {"id": "_agents_skills_graphify_skill_god_nodes", "label": "God Nodes", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_graph_json", "label": "graph.json", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_graphify_skill_interpreter_guard", "label": "Interpreter Guard", "file_type": "concept", "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_graphify_skill_skill", "target": "_agents_skills_graphify_references_github_and_merge_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_graphify_skill_skill", "target": "_agents_skills_graphify_references_transcribe_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_graphify_skill_skill", "target": "_agents_skills_g